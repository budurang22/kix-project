{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./**/application-secret*.properties)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.development)",
      "Edit(./.env.production)",
      "Edit(./backend/**)",
      "Edit(./frontend/**)",
      "Edit(./infra/**)",
      "Edit(./.github/**)",
      "Edit(./design/tokens/**)",
      "Edit(./.gitignore)",
      "Edit(./.editorconfig)",
      "Edit(./.env.example)"
    ],
    "ask": [
      "mcp__claude_ai_Notion__notion-create-pages",
      "mcp__claude_ai_Notion__notion-update-page",
      "mcp__claude_ai_Notion__notion-delete-pages",
      "mcp__claude_ai_Notion__notion-move-pages",
      "mcp__claude_ai_Notion__notion-duplicate-page",
      "mcp__claude_ai_Notion__notion-restore-pages",
      "mcp__claude_ai_Notion__notion-create-database",
      "mcp__claude_ai_Notion__notion-delete-databases",
      "mcp__claude_ai_Notion__notion-update-data-source",
      "mcp__claude_ai_Notion__notion-create-view",
      "mcp__claude_ai_Notion__notion-update-view",
      "mcp__claude_ai_Notion__notion-create-comment",
      "mcp__claude_ai_Notion__notion-update-comment",
      "mcp__claude_ai_Notion__notion-delete-comment"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && echo '[KIX] 학습 모드: Claude는 코드·설정·Git·배포를 직접 실행하지 않고 설명·예시·리뷰만 합니다. 규칙: .claude/rules/learning-mode.md' && echo '===== git =====' && git status -sb | head -20 && echo '===== docs/progress.md =====' && cat docs/progress.md && echo && echo '===== docs/decisions.md (최근 60줄) =====' && tail -n 60 docs/decisions.md && echo && echo '===== docs/learning (최근 파일) =====' && ls -t docs/learning | head -5"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\""
          }
        ]
      }
    ]
  }
}
